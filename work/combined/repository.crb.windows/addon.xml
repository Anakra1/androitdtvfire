<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.crb.windows" name="CBR Windows Add-on Repository" version="0.1.0" provider-name="CBR Project">
  <requires><import addon="xbmc.python" version="3.0.0"/></requires>
  <extension point="xbmc.addon.repository">
    <dir minversion="21.0.0">
      <info>https://anakra1.github.io/androitdtvfire/windows/addons.xml</info>
      <checksum>https://anakra1.github.io/androitdtvfire/windows/addons.xml.md5</checksum>
      <datadir zip="true">https://anakra1.github.io/androitdtvfire/windows/packages/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <platform>all</platform>
    <license>GPL-3.0-or-later</license>
    <summary lang="en_GB">CBR's Windows repository</summary>
    <description lang="en_GB">Provides the CBR skin, setup wizard, video add-on and integrated playback-engine dependency through one HTTPS repository.</description>
    <assets><icon>resources/icon.png</icon><fanart>resources/fanart.jpg</fanart></assets>
  </extension>
</addon>
